{
  "htmlWhitespaceSensitivity": "ignore",
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    },
    {
      "files": "*.md",
      "options": {
        "proseWrap": "never",
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
