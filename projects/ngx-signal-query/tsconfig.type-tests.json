/* Compile-time type tests: type-tests/ holds code that only has to compile, or must fail to (@ts-expect-error). */
/* It compiles against the built package (`pnpm build:lib` first), as an app's code does, and is never run. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    /* Checks, without writing them, the declaration files of what a test exports: see type-tests/declaration-emit.ts. tsc reports their errors once the rest compiles. */
    "declaration": true,
    "types": []
  },
  "include": ["type-tests/**/*.ts"],
  /* type-tests/register/ compiles on its own: see tsconfig.type-tests.register.json. */
  "exclude": ["type-tests/register/**"]
}
